# Google Gemini API (AI_API_KEY or GEMINI_API_KEY)
AI_PROVIDER=google
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.8-flash

# Optional: only needed for OpenAI-compatible providers
# AI_PROVIDER=openai-compatible
# AI_API_URL=https://api.example.com/v1/chat/completions
# AI_API_KEY=your-api-key
# AI_MODEL=your-model

# Optional in stateless mode. Required only when using OAuth sessions in production.
JWT_SECRET=replace-with-a-long-random-secret
